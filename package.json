{
  "name": "@kiwi-js/dom",
  "version": "0.0.0",
  "description": "Framework-free DOM helpers: predicate-driven element finding and description, plus small browser utilities shared between kiwi projects.",
  "keywords": [
    "dom",
    "shadow-dom",
    "kiwi"
  ],
  "license": "MIT",
  "author": "Miya",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiwi-Scripts/kiwi-dom.git"
  },
  "homepage": "https://github.com/Kiwi-Scripts/kiwi-dom#readme",
  "bugs": {
    "url": "https://github.com/Kiwi-Scripts/kiwi-dom/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "happy-dom": "^21.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
